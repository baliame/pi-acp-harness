{
	"name": "@pi-acp/harness",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"description": "Persistent ACP adapter for the upstream Pi SDK",
	"bin": {
		"pi-acp-harness": "dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./experimental/multi-client-attach": {
			"types": "./dist/experimental/multi-client-attach.d.ts",
			"default": "./dist/experimental/multi-client-attach.js"
		},
		"./experimental/prompt-delivery": {
			"types": "./dist/experimental/prompt-delivery.d.ts",
			"default": "./dist/experimental/prompt-delivery.js"
		},
		"./capabilities/shared-queue": {
			"types": "./dist/capabilities/shared-queue.d.ts",
			"default": "./dist/capabilities/shared-queue.js"
		}
	},
	"files": [
		"dist",
		"examples",
		"docs",
		"LICENSE",
		"licenses"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "biome check src test examples scripts && tsc --noEmit && node scripts/check.mjs"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "2.4.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"typebox": "1.3.27",
		"ws": "8.22.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"@types/ws": "8.18.1",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
